# Shared environment for all microservices. Copy to .env and fill real values.
APP_ENV=development

# ---- Database (PostgreSQL on host) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fire_extinguisher_db
DB_USER=postgres
DB_PASSWORD=change_me

# ---- JWT / Auth ----
JWT_SECRET=change_me_long_random
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_me_long_random_too
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000

# Internal service-to-service shared key
INTERNAL_KEY=change_me_internal_key

# ---- Service ports ----
GATEWAY_PORT=5000
AUTH_PORT=4001
USER_PORT=4002
EXTINGUISHER_PORT=4003
INSPECTION_PORT=4004
REPORTING_PORT=4005
NOTIFICATION_PORT=4006

# ---- Internal service URLs ----
AUTH_URL=http://localhost:4001
USER_URL=http://localhost:4002
EXTINGUISHER_URL=http://localhost:4003
INSPECTION_URL=http://localhost:4004
REPORTING_URL=http://localhost:4005
NOTIFICATION_URL=http://localhost:4006

# ---- Email ----
MAIL_MODE=simulated
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=change_me
SMTP_FROM="TZW Fire Safety <no-reply@example.com>"
FRONTEND_URL=http://localhost:5173

LOG_LEVEL=info
